  "narrative": {
    "northStar": "Focused workbench",
    "overview": "Codex Workbench uses a neutral graphite and white interface with forest green for actions and meaningful states. Content, lists, and dividers establish hierarchy across sessions, settings, files, and conversation tools.\n\nThis document records the implemented system. It describes the current source rather than a separately approved brand identity; configurable typography and themes remain part of the interface.",
    "keyCharacteristics": [
      "Compact controls with clear text hierarchy.",
      "Flat working surfaces, divided lists, and restrained overlays.",
      "Semantic colors paired with readable labels and interaction states."
    ],
    "rules": [
      {
        "name": "The Action Pair Rule",
        "body": "Always pair action fills with on-action text; dark mode uses dark text on the lighter green fill.",
        "section": "colors"
      },
      {
        "name": "The Preference Rule",
        "body": "New interface text follows scalable roles, and code follows the independent code preference. Mobile editable controls use at least (16px) to avoid focus zoom.",
        "section": "typography"
      },
      {
        "name": "The Overlay Rule",
        "body": "Reserve pronounced shadow for floating controls, dialogs, and transient notices. Use divisions and tonal surfaces for routine content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic color variables so light and dark modes stay aligned.",
      "Do preserve font scaling, independent code sizing, and mobile input sizing.",
      "Do use dividers and spacing to group settings and working lists.",
      "Do keep keyboard focus visible and respect reduced motion."
    ],
    "donts": [
      "Don't hardcode white text on primary actions; use the on-action token.",
      "Don't add decorative heroes, gradients, or repeated cards to working screens.",
      "Don't hide row actions from keyboard focus or touch users.",
      "Don't treat the start-page heading or smaller legacy text sizes as a reusable display system."
    ]
  }
}
