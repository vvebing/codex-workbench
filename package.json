{
  "name": "codex-workbench",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node dist/server/index.js",
    "clean": "node scripts/clean.mjs",
    "build": "npm run typecheck && npm run clean && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:repository && npm run check:release-tools && npm run check:release && npm run typecheck && npm run check:protocol && npm run lint && npm run format:check && npm test",
    "audit:protocol": "node scripts/audit-app-server.mjs",
    "check:protocol": "node scripts/audit-app-server.mjs --check",
    "check:repository": "node scripts/check-repository.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:app-server": "node --import tsx tests/smoke/app-server.ts",
    "daemon": "node scripts/launchd.mjs",
    "daemon:install": "node scripts/launchd.mjs install",
    "daemon:uninstall": "node scripts/launchd.mjs uninstall",
    "daemon:start": "node scripts/launchd.mjs start",
    "daemon:stop": "node scripts/launchd.mjs stop",
    "daemon:restart": "node scripts/launchd.mjs restart",
    "daemon:status": "node scripts/launchd.mjs status",
    "daemon:logs": "node scripts/launchd.mjs logs",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "commit": "cz",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "patch:release-tools": "node scripts/patch-release-tools.mjs",
    "check:release-tools": "node scripts/patch-release-tools.mjs --check",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cmdk": "^1.1.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ignore": "^5.3.2",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "npm-ip-address-patch": "npm:ip-address@^10.7.4",
    "npm-undici-patch": "npm:undici@^6.29.1",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  },
  "description": "A local-first Chinese web workbench for Codex: sessions, queues, approvals, and multi-environment workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vvebing/codex-workbench.git"
  },
  "homepage": "https://github.com/vvebing/codex-workbench#readme",
  "bugs": {
    "url": "https://github.com/vvebing/codex-workbench/issues"
  },
  "keywords": [
    "codex",
    "workbench",
    "cli",
    "web-ui",
    "app-server"
  ],
  "bin": {
    "codex-workbench": "dist/server/index.js"
  },
  "files": [
    "dist/client/",
    "dist/server/",
    "docs/*.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "license": "MIT"
}
